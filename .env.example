# ──────────────────────────────────────────────
# WhatsApp Cloud API
# ──────────────────────────────────────────────
# Temporary access token from Meta Developer Dashboard
# (Meta → Your App → WhatsApp → API Setup → copy "Temporary access token")
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# Phone Number ID (NOT the phone number itself)
# (Meta → Your App → WhatsApp → API Setup → copy "Phone number ID")
WHATSAPP_PHONE_ID=your_phone_number_id_here

# ──────────────────────────────────────────────
# Webhook Security
# ──────────────────────────────────────────────
# Any random string you choose — must match what you enter in Meta's webhook config
WEBHOOK_VERIFY_TOKEN=my_super_secret_verify_token

# App Secret from Meta Developer Dashboard (used for HMAC signature verification)
# (Meta → Your App → Settings → Basic → App Secret)
APP_SECRET=your_app_secret_here

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
# Where to save downloaded files (default: ./storage)
STORAGE_DIR=./storage
