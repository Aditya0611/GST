# ──────────────────────────────────────────────
# WhatsApp Cloud API
# ──────────────────────────────────────────────
# Temporary access token from Meta Developer Dashboard
# (Meta → Your App → WhatsApp → API Setup → copy "Temporary access token")
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# Phone Number ID (NOT the phone number itself)
# (Meta → Your App → WhatsApp → API Setup → copy "Phone number ID")
WHATSAPP_PHONE_ID=your_phone_number_id_here

# Public WhatsApp number for landing-page wa.me links (digits only, with country code, no +)
# Example Meta test: 15556384094 for +1 555 638 4094
WHATSAPP_DISPLAY_NUMBER=15556384094

# ──────────────────────────────────────────────
# Webhook Security
# ──────────────────────────────────────────────
# Any random string you choose — must match what you enter in Meta's webhook config
WEBHOOK_VERIFY_TOKEN=my_super_secret_verify_token

# App Secret from Meta Developer Dashboard (used for HMAC signature verification)
# (Meta → Your App → Settings → Basic → App Secret)
# REQUIRED — webhook POSTs are rejected if this is empty
APP_SECRET=your_app_secret_here

# ──────────────────────────────────────────────
# Dashboard API Auth
# ──────────────────────────────────────────────
# Shared secret for CA dashboard REST APIs (send as X-API-Key header).
# Leave empty only for local/dev (APIs stay open with a startup warning).
DASHBOARD_API_KEY=change_me_to_a_long_random_string

# ──────────────────────────────────────────────
# AI Processing
# ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Which provider to use for invoice extraction: "gemini" (default) or "groq"
INVOICE_LLM_PROVIDER=gemini
# WhatsApp / dashboard agent provider: "groq" (recommended) or "gemini"
AGENT_LLM_PROVIDER=groq
AGENT_MODEL=llama-3.3-70b-versatile
# GEMINI_AGENT_MODEL=models/gemini-2.5-flash

# ──────────────────────────────────────────────
# Database (optional)
# ──────────────────────────────────────────────
# Leave unset to use local SQLite under STORAGE_DIR.
# Set to a Postgres URL for production, e.g. postgresql://user:pass@host:5432/gst
# DATABASE_URL=postgresql://user:pass@localhost:5432/gst_autopilot

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
# Where to save downloaded files (default: ./storage)
STORAGE_DIR=./storage

# ──────────────────────────────────────────────
# Sandbox (Quicko GSP) — GST portal APIs
# ──────────────────────────────────────────────
# From https://developer.sandbox.co.in console (API keys).
# Prefer test keys while developing; use live keys only in production.
SANDBOX_API_KEY=key_test_or_live_here
SANDBOX_API_SECRET=secret_test_or_live_here
# Optional: SANDBOX_API_BASE=https://api.sandbox.co.in
# Optional: SANDBOX_PORTAL_CACHE_TTL_HOURS=24
# Live GSTR-2B (OTP): taxpayer must Enable API Access on gst.gov.in
# (View Profile → Manage API Access) before Pull 2B (OTP) works.

